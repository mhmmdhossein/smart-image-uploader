{
  "name": "smart-image-uploader",
  "version": "0.1.0",
  "description": "React image uploader that resizes, compresses and optionally cuts out a flat background in the browser — with a stepped progress bar. No CSS framework, no dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./pipeline": "./src/imagePipeline.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "image-upload",
    "image-compression",
    "background-removal",
    "webp",
    "canvas",
    "nextjs"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/USERNAME/smart-image-uploader.git"
  }
}
